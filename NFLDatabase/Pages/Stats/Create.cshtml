@page
@model NFLDatabase.Pages.Stats.CreateModel

@{
    ViewData["Title"] = "Create Season Stats";
}

<h1>Create</h1>

<h4>Season Stats</h4>
<hr />
<div class="row">
    <div class="col-md-8">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Stats.PlayerId" class="control-label">Player</label>
                <select asp-for="Stats.PlayerId" class="form-control" asp-items="Model.PlayerOptions"></select>
            </div>
            <partial name="_StatsFields" for="Stats" />
            <div class="form-group mt-3">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
