@page
@model NFLDatabase.Pages.Stats.EditModel

@{
    ViewData["Title"] = "Edit Season Stats";
}

<h1>Edit</h1>

<h4>Season Stats - @Model.PlayerName</h4>
<hr />
<div class="row">
    <div class="col-md-8">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Stats.Id" />
            <input type="hidden" asp-for="Stats.PlayerId" />
            <partial name="_StatsFields" for="Stats" />
            <div class="form-group mt-3">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
