@page
@model NFLDatabase.Pages.Stats.DeleteModel

@{
    ViewData["Title"] = "Delete Season Stats";
}

<h1>Delete</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>Season Stats</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Player</dt>
        <dd class="col-sm-10">@Model.Stats.Player?.FullName</dd>
        <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Stats.Season)</dt>
        <dd class="col-sm-10">@Model.Stats.Season</dd>
        <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Stats.GamesPlayed)</dt>
        <dd class="col-sm-10">@Model.Stats.GamesPlayed</dd>
    </dl>

    <form method="post">
        <input type="hidden" asp-for="Stats.Id" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-page="./Index">Back to List</a>
    </form>
</div>
