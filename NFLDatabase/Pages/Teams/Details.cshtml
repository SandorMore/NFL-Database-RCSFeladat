@page
@model NFLDatabase.Pages.Teams.DetailsModel

@{
    ViewData["Title"] = "Team Details";
}

<h1>Details</h1>

<div>
    <h4>Team</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Team.Name)</dt>
        <dd class="col-sm-10">@Model.Team.Name</dd>
        <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Team.Abbreviation)</dt>
        <dd class="col-sm-10">@Model.Team.Abbreviation</dd>
        <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Team.City)</dt>
        <dd class="col-sm-10">@Model.Team.City</dd>
        <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Team.Color)</dt>
        <dd class="col-sm-10">@Model.Team.Color</dd>
        <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Team.LogoUrl)</dt>
        <dd class="col-sm-10">
            @if (!string.IsNullOrEmpty(Model.Team.LogoUrl))
            {
                <img src="@Model.Team.LogoUrl" alt="@Model.Team.Name" height="80" />
            }
        </dd>
    </dl>
</div>

<h4>Players (@Model.Team.Players.Count)</h4>
<table class="table table-sm">
    <thead>
        <tr>
            <th>#</th>
            <th>Name</th>
            <th>Position</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var p in Model.Team.Players.OrderBy(p => p.LastName))
        {
            <tr>
                <td>@p.JerseyNumber</td>
                <td><a asp-page="/Players/Details" asp-route-id="@p.Id">@p.FullName</a></td>
                <td>@p.Position</td>
            </tr>
        }
    </tbody>
</table>

<div>
    <a asp-page="./Edit" asp-route-id="@Model.Team.Id">Edit</a> |
    <a asp-page="./Index">Back to List</a>
</div>
