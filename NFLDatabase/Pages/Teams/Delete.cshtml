@page
@model NFLDatabase.Pages.Teams.DeleteModel

@{
    ViewData["Title"] = "Delete Team";
}

<h1>Delete</h1>

<h3>Are you sure you want to delete this? Its players will become free agents.</h3>
<div>
    <h4>Team</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Team.Name)</dt>
        <dd class="col-sm-10">@Model.Team.Name</dd>
        <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Team.Abbreviation)</dt>
        <dd class="col-sm-10">@Model.Team.Abbreviation</dd>
        <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Team.City)</dt>
        <dd class="col-sm-10">@Model.Team.City</dd>
    </dl>

    <form method="post">
        <input type="hidden" asp-for="Team.Id" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-page="./Index">Back to List</a>
    </form>
</div>
