@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}

<h1>NFL Database</h1>
<p class="text-muted">Teams, players and season stats imported from ESPN.</p>

<div class="row mt-4">
    <div class="col-md-4 mb-3">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Teams</h5>
                <p class="card-text display-6">@Model.TeamCount</p>
                <a asp-page="/Teams/Index" class="btn btn-primary">View teams</a>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-3">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Players</h5>
                <p class="card-text display-6">@Model.PlayerCount</p>
                <a asp-page="/Players/Index" class="btn btn-primary">View players</a>
            </div>
        </div>
    </div>
    <div class="col-md-4 mb-3">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Season Stats</h5>
                <p class="card-text display-6">@Model.StatsCount</p>
                <a asp-page="/Stats/Index" class="btn btn-primary">View stats</a>
            </div>
        </div>
    </div>
</div>
