@page
@model NFLDatabase.Pages.Players.DeleteModel

@{
    ViewData["Title"] = "Delete Player";
}

<h1>Delete</h1>

<h3>Are you sure you want to delete this? Their season stats will be deleted too.</h3>
<div>
    <h4>Player</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Player.FullName)</dt>
        <dd class="col-sm-10">@Model.Player.FullName</dd>
        <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Player.Position)</dt>
        <dd class="col-sm-10">@Model.Player.Position</dd>
        <dt class="col-sm-2">@Html.DisplayNameFor(m => m.Player.Team)</dt>
        <dd class="col-sm-10">@(Model.Player.Team?.Name ?? "Free agent")</dd>
    </dl>

    <form method="post">
        <input type="hidden" asp-for="Player.Id" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-page="./Index">Back to List</a>
    </form>
</div>
