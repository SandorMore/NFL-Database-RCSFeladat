@page
@model NFLDatabase.Pages.Players.IndexModel

@{
    ViewData["Title"] = "Players";
}

<h1>Players</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(m => m.Players[0].FullName)</th>
            <th>@Html.DisplayNameFor(m => m.Players[0].JerseyNumber)</th>
            <th>@Html.DisplayNameFor(m => m.Players[0].Position)</th>
            <th>@Html.DisplayNameFor(m => m.Players[0].Side)</th>
            <th>@Html.DisplayNameFor(m => m.Players[0].Team)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Players)
        {
            <tr>
                <td>@item.FullName</td>
                <td>@item.JerseyNumber</td>
                <td>@item.Position</td>
                <td>@Html.DisplayFor(m => item.Side)</td>
                <td>@(item.Team?.Abbreviation ?? "Free agent")</td>
                <td>
                    <a asp-page="./Edit" asp-route-id="@item.Id">Edit</a> |
                    <a asp-page="./Details" asp-route-id="@item.Id">Details</a> |
                    <a asp-page="./Delete" asp-route-id="@item.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
