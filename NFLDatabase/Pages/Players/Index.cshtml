@page
@using NFLDatabase.Models
@model NFLDatabase.Pages.Players.IndexModel

@{
    ViewData["Title"] = "Players";
}

<h1>Players</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>

<form method="get" class="row g-2 align-items-end mb-3">
    <div class="col-auto">
        <label asp-for="Side" class="form-label"></label>
        <select asp-for="Side" class="form-select" asp-items="Html.GetEnumSelectList<PlayerSide>()">
            <option value="">All</option>
        </select>
    </div>
    <div class="col-auto">
        <label asp-for="Position" class="form-label"></label>
        <select asp-for="Position" class="form-select" asp-items="Model.PositionOptions">
            <option value="">All</option>
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Filter</button>
        <a asp-page="./Index" class="btn btn-outline-secondary">Clear</a>
    </div>
    <div class="col-auto ms-auto">
        <a asp-page="./Index" asp-route-side="Offense" class="btn btn-outline-primary">Offense</a>
        <a asp-page="./Index" asp-route-side="Defense" class="btn btn-outline-primary">Defense</a>
        <a asp-page="./Index" asp-route-side="SpecialTeams" class="btn btn-outline-primary">Special Teams</a>
        <a asp-page="./Index" asp-route-position="RB" class="btn btn-outline-primary">Running Backs</a>
    </div>
</form>

<p class="text-muted">@Model.Players.Count players</p>

<table class="table">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(m => m.Players[0].FullName)</th>
            <th>@Html.DisplayNameFor(m => m.Players[0].JerseyNumber)</th>
            <th>@Html.DisplayNameFor(m => m.Players[0].Position)</th>
            <th>@Html.DisplayNameFor(m => m.Players[0].Side)</th>
            <th>@Html.DisplayNameFor(m => m.Players[0].Team)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Players)
        {
            <tr>
                <td>@item.FullName</td>
                <td>@item.JerseyNumber</td>
                <td>@item.Position</td>
                <td>@Html.DisplayFor(m => item.Side)</td>
                <td>@(item.Team?.Abbreviation ?? "Free agent")</td>
                <td>
                    <a asp-page="./Edit" asp-route-id="@item.Id">Edit</a> |
                    <a asp-page="./Details" asp-route-id="@item.Id">Details</a> |
                    <a asp-page="./Delete" asp-route-id="@item.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
